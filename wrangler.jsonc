{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghostdrop",
  "account_id": "372c721f03a9c2e5dc7bc93fc6e94b98",
  "compatibility_date": "2026-11-03",
  "main": "./workers/app.ts",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNT", "class_name": "Account" },
      { "name": "CHALLENGE", "class_name": "Challenge" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Account", "Challenge"] }],
  "r2_buckets": [{ "binding": "DROPS", "bucket_name": "ghostdrop-drops" }],
}
